import java.util.Scanner;
public class JavaWeek4 {

    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);
        
        for (int i = 1; i <= 10; i++) {
            System.out.println("Number: " + i + " | Square: " + (i * i));
        }

        System.out.println();
        System.out.println("Changed loop bound to 20:");

        for (int i = 1; i <= 20; i++) {
            System.out.println("Number: " + i + " | Square: " + (i * i));
        }
        
                /** ================================================== **/
        /** Sum Until Sentinel Value **/

        System.out.println("\n ___________________");
        
        int number;
        int total = 0;

        System.out.print("Enter a number (-1 to stop): ");
        number = input.nextInt();

        while (number != -1) {
            total += number;

            System.out.print("Enter a number (-1 to stop): ");
            number = input.nextInt();
        }

        System.out.println("Final total: " + total);

        
                /** ================================================== **/
        /** Pattern Genarator With Early Exit **/

        System.out.println("\n ___________________");
        
        System.out.println();
        System.out.println("=================================");
        System.out.println("3. PATTERN GENERATOR WITH EARLY EXIT");
        System.out.println("=================================");

        int size = 5;

        for (int row = 1; row <= size; row++) {

            for (int column = 1; column <= size; column++) {

                // CONTINUE: skips printing when column is 3
                if (column == 3) {
                    continue;
                }

                // BREAK: stops the inner loop when column reaches 5
                if (column == 5 && row == 4) {
                    break;
                }

                System.out.print("* ");
            }

            System.out.println();
        }
        
        
                /** ================================================== **/
        /** Warehouse Inventor Scanner **/

        System.out.println("\n ___________________");
        
        int[][] inventory = {
            {10, 25, 15, -1},
            {30, 8, 20, 12},
            {5, 18, 22, 7}
        };

        int choice = 0;

        while (choice != 4) {

            System.out.println();
            System.out.println("WAREHOUSE MENU");
            System.out.println("1. Show Inventory");
            System.out.println("2. Total Inventory");
            System.out.println("3. Find First Critically Low Shelf");
            System.out.println("4. Exit");

            System.out.print("Enter your choice: ");
            choice = input.nextInt();

            if (choice == 1) {

                System.out.println();
                System.out.println("INVENTORY:");

                for (int row = 0; row < inventory.length; row++) {

                    for (int column = 0; column < inventory[row].length; column++) {

                        System.out.print(inventory[row][column] + " ");
                    }

                    System.out.println();
                }

            } else if (choice == 2) {

                int totalInventory = 0;

                for (int row = 0; row < inventory.length; row++) {

                    for (int column = 0; column < inventory[row].length; column++) {

                        if (inventory[row][column] == -1) {
                            continue;
                        }

                        totalInventory += inventory[row][column];
                    }
                }

                System.out.println("Total Inventory: " + totalInventory);

            } else if (choice == 3) {

                boolean found = false;

                for (int row = 0; row < inventory.length; row++) {

                    for (int column = 0; column < inventory[row].length; column++) {

                        if (inventory[row][column] == -1) {
                            continue;
                        }

                        if (inventory[row][column] < 10) {

                            System.out.println(
                                "First critically low shelf found at Row "
                                + (row + 1) + ", Column " + (column + 1)
                                + " with " + inventory[row][column] + " items."
                            );

                            found = true;
                            break;
                        }
                    }

                    if (found) {
                        break;
                    }
                }

                if (!found) {
                    System.out.println("No critically low shelf found.");
                }

            } else if (choice == 4) {

                System.out.println("Exiting warehouse scanner...");

            } else {

                System.out.println("Invalid choice. Please try again.");
            }
        }

        input.close();
    }
    
    }

