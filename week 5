import java.util.Arrays;

public class Javaweek5 {

    public static void main(String[] args) {

        String[] favorites = { "Pompompurin", "Drawing", "Writing", "Watching Movies", "Ghibli"};

        for (int i = 0; i < favorites.length; i++) {
            System.out.println((i + 1) + ". " + favorites[i]);
        }

        System.out.println("Total Favorites: " + favorites.length);


        /** ================================================== **/
        /** Class statistics calculator **/

        System.out.println("\n ___________________");

        int[] scores = {85, 90, 78, 92, 88, 76, 95, 84};

        int sum = 0;
        int highest = scores[0];
        int lowest = scores[0];

        for (int i = 0; i < scores.length; i++) {

            sum += scores[i];

            if (scores[i] > highest) {
                highest = scores[i];
            }

            if (scores[i] < lowest) {
                lowest = scores[i];
            }
        }

        double average = (double) sum / scores.length;

        System.out.println("\n     CLASS STATISTICS ");
        System.out.println("Sum: " + sum);
        System.out.println("Average: " + average);
        System.out.println("Highest Score: " + highest);
        System.out.println("Lowest Score: " + lowest);


        /** ================================================== **/
        /** Search and sort mini tool **/

        System.out.println("\n ___________________");

        int target = 92;
        int foundIndex = -1;

        for (int i = 0; i < scores.length; i++) {

            if (scores[i] == target) {
                foundIndex = i;
                break;
            }
        }

        if (foundIndex != -1) {
            System.out.println("Score " + target + " found at index: " + foundIndex);
        } else {
            System.out.println("Score " + target + " was not found.");
        }

        int[] sortedScores = Arrays.copyOf(scores, scores.length);

        Arrays.sort(sortedScores);

        System.out.println("Original Scores: " + Arrays.toString(scores));
        System.out.println("Sorted Scores: " + Arrays.toString(sortedScores));


        /** ================================================== **/
        /** Class ranking system **/

        System.out.println("\n ___________________");

        String[][] rawQuizData = {
            {"Ivan", "90", "85", "95", "92"},
            {"Till", "80", "85", "90", "85"},
            {"Luka", "95", "93", "94", "96"},
            {"Mizi", "88", "90", "87", "92"},
            {"Sua", "95", "92", "94", "96"}
        };

        Student[] students = new Student[rawQuizData.length];

        for (int i = 0; i < rawQuizData.length; i++) {

            String name = rawQuizData[i][0];

            int[] quizzes = new int[4];

            for (int j = 0; j < 4; j++) {
                quizzes[j] = Integer.parseInt(rawQuizData[i][j + 1]);
            }

            students[i] = new Student(name, quizzes);
        }

        
        for (int i = 0; i < students.length - 1; i++) {

            for (int j = 0; j < students.length - 1 - i; j++) {

                if (students[j].getAverage() < students[j + 1].getAverage()) {

                    Student temp = students[j];
                    students[j] = students[j + 1];
                    students[j + 1] = temp;
                }
            }
        }

        System.out.println("\n     CLASS RANKING");

        System.out.println("Rank\tName\t\tAverage");
        System.out.println("--------------------------------");

        int rank = 1;

        for (int i = 0; i < students.length; i++) {

            if (i > 0 && students[i].getAverage() < students[i - 1].getAverage()) {
                rank = i + 1;
            }

            System.out.printf(
                "%d\t%-15s %.2f%n",
                rank,
                students[i].name,
                students[i].getAverage()
            );
        }

        String searchName = "Mizi";

        int studentRank = findRank(students, searchName);

        System.out.println("\nSearching for student: " + searchName);

        if (studentRank != -1) {
            System.out.println(searchName + "'s Rank: " + studentRank);
        } else {
            System.out.println("Student not found.");
        }
    }

    static class Student {

        String name;
        int[] quizzes;

        Student(String name, int[] quizzes) {
            this.name = name;
            this.quizzes = quizzes;
        }

        double getAverage() {

            int total = 0;

            for (int i = 0; i < quizzes.length; i++) {
                total += quizzes[i];
            }

            return (double) total / quizzes.length;
        }
    }


    static int findRank(Student[] students, String searchName) {

        for (int i = 0; i < students.length; i++) {

            if (students[i].name.equalsIgnoreCase(searchName)) {

                int rank = 1;

                for (int j = 0; j < i; j++) {

                    if (students[j].getAverage() > students[i].getAverage()) {
                        rank++;
                    }
                }

                return rank;
            }
        }

        return -1;
    }
}
