public class Javaweek3 {

    public static void main(String[] args) {

        int score = 61;

        if (score >= 60) {
            System.out.println("Score: "
                    + score);
            System.out.println("PASSED");
        } else {
            System.out.println("Score: "
                    + score);
            System.out.println("FAILED");
        }

        /** ================================================== **/
        /** Multi-tier discount system **/

        System.out.println("\n ___________________");

        double purchaseAmount = 1500;
        double discountRate;
        String discountTier;

        if (purchaseAmount < 500) {
            discountRate = 0.00;
            discountTier = "No Discount";
        } else if (purchaseAmount < 1000) {
            discountRate = 0.05;
            discountTier = "5% Discount";
        } else if (purchaseAmount < 2000) {
            discountRate = 0.10;
            discountTier = "10% Discount";
        } else {
            discountRate = 0.15;
            discountTier = "15% Discount";
        }

        double discount = purchaseAmount * discountRate;
        double finalPrice = purchaseAmount - discount;

        System.out.println("Purchase Amount: " + purchaseAmount);
        System.out.println("Discount Tier: " + discountTier);
        System.out.println("Discount Amount: " + discount);
        System.out.println("Final Discounted Price: " + finalPrice);

        /** ================================================== **/
        /** Nested Login Validator **/

        System.out.println("\n ___________________");

        String correctUsername = "admin";
        String correctPassword = "1234";
        boolean accountLocked = false;

        String username = "admin";
        String password = "1234";

        if (username.equals(correctUsername)) {

            if (password.equals(correctPassword)) {

                if (!accountLocked) {
                    System.out.println("LOGIN SUCCESSFUL");
                    System.out.println("Welcome, " + username + "!");
                } else {
                    System.out.println("LOGIN FAILED");
                    System.out.println("Reason: The account is locked.");
                }

            } else {
                System.out.println("LOGIN FAILED");
                System.out.println("Reason: Incorrect password.");
            }

        } else {
            System.out.println("LOGIN FAILED");
            System.out.println("Reason: Incorrect username.");
        }

        /** ================================================== **/
        /** ATM Transaction Authorizer **/

        System.out.println("\n ___________________");

        String atmUsername = "admin";
        int atmPin = 1234;

        String enteredUsername = "admin";
        int enteredPin = 1234;

        double balance = 10000;
        double withdrawalAmount = 3000;

        boolean atmAccountLocked = false;

        String accountTier;
        double feeRate;

        if (enteredUsername.equals(atmUsername)) {

            if (enteredPin == atmPin) {

                if (!atmAccountLocked) {

                    if (balance < 1000) {
                        accountTier = "Bronze";
                    } else if (balance < 5000) {
                        accountTier = "Silver";
                    } else if (balance < 10000) {
                        accountTier = "Gold";
                    } else {
                        accountTier = "Platinum";
                    }

                    System.out.println("Account Tier: " + accountTier);
                    System.out.println("Current Balance: " + balance);

                    switch (accountTier) {
                        case "Bronze":
                            feeRate = 0.05;
                            break;

                        case "Silver":
                            feeRate = 0.03;
                            break;

                        case "Gold":
                            feeRate = 0.02;
                            break;

                        case "Platinum":
                            feeRate = 0.01;
                            break;

                        default:
                            feeRate = 0.05;
                    }

                    double fee = withdrawalAmount * feeRate;
                    double totalAmount = withdrawalAmount + fee;

                    if (withdrawalAmount <= 0) {
                        System.out.println("DENY");
                        System.out.println("Reason: Withdrawal amount must be greater than zero.");

                    } else if (totalAmount > balance) {
                        System.out.println("DENY");
                        System.out.println("Reason: Insufficient balance including transaction fee.");

                    } else if (withdrawalAmount > 5000 && accountTier.equals("Bronze")) {
                        System.out.println("DENY");
                        System.out.println("Reason: Bronze account withdrawal limit is 5000.");

                    } else {
                        double remainingBalance = balance - totalAmount;

                        System.out.println("APPROVE");
                        System.out.println("Withdrawal Amount: " + withdrawalAmount);
                        System.out.println("Transaction Fee: " + fee);
                        System.out.println("Total Deducted: " + totalAmount);
                        System.out.println("Remaining Balance: " + remainingBalance);
                    }

                } else {
                    System.out.println("DENY");
                    System.out.println("Reason: Account is locked.");
                }

            } else {
                System.out.println("DENY");
                System.out.println("Reason: Incorrect PIN.");
            }

        } else {
            System.out.println("DENY");
            System.out.println("Reason: Incorrect username.");
        }

    }
}
